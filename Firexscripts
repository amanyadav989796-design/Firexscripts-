local function postJson(endpoint, payload)
    if not requestFunc then return nil end
    local ok, res = pcall(function()
        return requestFunc({
            Url = API_URL .. endpoint,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)
    if ok and res and res.Body then
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if decodeOk then return data end
    end
    return nil
end

local function verifyWithServer(keyToTest)
    return postJson("/verify", {
        account_id = ACCOUNT_ID,
        device_id = DEVICE_ID,
        key = keyToTest
    })
end

